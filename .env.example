# Copy to .env and adjust. Every value is optional; the defaults are shown.

# --- Browser -----------------------------------------------------------------
# Run without a visible window. Set to false if Cloudflare starts challenging:
# a visible browser passes more easily and lets you solve a challenge by hand.
TRN_HEADLESS=true
# chrome (your installed Google Chrome), msedge, or chromium (the bundled build,
# installed with "patchright install chromium"). Chromium is the automatic fallback.
TRN_BROWSER_CHANNEL=chrome
# Full path to a Chrome binary, for installs in a non-standard location.
TRN_BROWSER_EXECUTABLE=
# Leave empty to use the browser's own user agent (recommended).
TRN_USER_AGENT=
# Close the browser after this many idle seconds. 0 keeps it open.
TRN_BROWSER_IDLE_SECONDS=120

# --- Politeness --------------------------------------------------------------
# Random pause between two requests, in seconds.
TRN_MIN_DELAY=1.5
TRN_MAX_DELAY=4.0
# 1 or 2. Keep this at 1: with 2 the pause is measured between request starts.
TRN_MAX_CONCURRENT_SCRAPES=1
# Cap on requests per hour, shared by all copies that use the same data folder.
# 0 disables the cap.
TRN_MAX_REQUESTS_PER_HOUR=240

# --- Failure handling --------------------------------------------------------
# 0 to 3.
TRN_MAX_RETRIES=2
TRN_BACKOFF_BASE=2.0
TRN_REQUEST_TIMEOUT=30
# How long to wait for a Cloudflare challenge to clear, in seconds.
TRN_CHALLENGE_TIMEOUT=30

# --- Cache lifetimes, in seconds ---------------------------------------------
TRN_CACHE_TTL_OVERVIEW=2700
TRN_CACHE_TTL_AGENTS=5400
TRN_CACHE_TTL_MAPS=5400
TRN_CACHE_TTL_MATCHES=1200
TRN_CACHE_TTL_CAREER=21600
TRN_CACHE_TTL_SEARCH=3600
TRN_CACHE_TTL_MATCH_DETAILS=2592000

# --- FlareSolverr (optional) -------------------------------------------------
# Used as a fallback when set, or as the primary with TRN_BACKEND=flaresolverr.
FLARESOLVERR_URL=
TRN_FLARESOLVERR_TIMEOUT_MS=60000
TRN_BACKEND=playwright

# --- Storage and logging -----------------------------------------------------
# Holds the SQLite cache, the browser profiles and the pacing that copies of the
# server share. Defaults to .data in the project.
TRN_DATA_DIR=
TRN_LOG_LEVEL=INFO

# --- Transport ---------------------------------------------------------------
# stdio or streamable-http. Host and port apply to streamable-http only.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
